# ---- LLM provider switch ----
# "groq" (default, cloud, needs an API key, fast) or "ollama" (fully local, zero cost)
LLM_PROVIDER=groq

# ---- Groq (https://console.groq.com/keys) ----
GROQ_API_KEY=your_groq_api_key_here
# Main reasoning model used by the Supervisor, Itinerary, Flight/Hotel and Trip Compiler agents
GROQ_MODEL=openai/gpt-oss-120b
# Cheaper/faster model used for lightweight guardrail checks, extraction and routing
GROQ_FAST_MODEL=openai/gpt-oss-20b
# See https://console.groq.com/docs/models for the current list -- Groq's lineup changes
# over time, so if a model 404s, swap in whatever's currently listed there.

# ---- Ollama (https://ollama.com, run `ollama pull llama3.1` first) ----
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ---- App ----
HOST=0.0.0.0
PORT=8000
